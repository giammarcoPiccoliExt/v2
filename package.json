{
  "name": "car-calendar-booking",
  "version": "0.1.0",
  "private": true,
  "main": "gui/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"npx http-server public -p 3001\"",
    "electron": "electron .",
    "pack:win": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-fetch": "^2.6.7",
    "selfsigned": "^5.5.0",
    "sqlite3": "^5.0.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^40.6.0",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.5"
  },
  "build": {
    "appId": "com.giammarco.carbooking",
    "files": [
      "**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
